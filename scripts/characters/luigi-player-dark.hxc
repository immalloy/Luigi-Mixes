import funkin.data.character.CharacterDataParser;
import funkin.play.character.BaseCharacter;
import funkin.play.character.SparrowCharacter;

/**
 * Mirrors the Week 2 Erect dark-character behavior: lightning reveals the
 * normal Luigi underneath while this dark variant fades back in.
 */
class LuigiPlayerDarkCharacter extends SparrowCharacter {
  var normalChar:BaseCharacter;

  function new() {
    super('luigi-player-dark');
  }

  override function set_alpha(value:Float):Float {
    super.set_alpha(value);

    if (normalChar != null) {
      normalChar.alpha = value == 1 ? 0.0001 : 1;
    }

    return value;
  }

  override function playAnimation(name:String, restart:Bool = false, ignoreOther:Bool = false, reversed:Bool = false):Void {
    super.playAnimation(name, restart, ignoreOther, reversed);

    if (normalChar != null) {
      normalChar.playAnimation(name, restart, ignoreOther, reversed);
      syncNormalChar();
    }
  }

  override function onUpdate(event:UpdateScriptEvent):Void {
    super.onUpdate(event);

    syncNormalChar();
  }

  function syncNormalChar():Void {
    if (normalChar == null) return;

    var darkFeet = this.feetPosition;
    normalChar.setPosition(darkFeet.x - normalChar.characterOrigin.x, darkFeet.y - normalChar.characterOrigin.y);
  }

  override function onCreate(event:ScriptEvent):Void {
    super.onCreate(event);

    if (!this.debug) {
      normalChar = CharacterDataParser.fetchCharacter('luigi-player');
      normalChar.zIndex = 199;
      normalChar.alpha = 0.0001;
      normalChar.flipX = false;
      syncNormalChar();

      currentStage.add(normalChar);
      currentStage.refresh();
    }
  }
}
